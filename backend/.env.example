# Supabase → Connect → ORMs / Connection string
# Transaction pooler (port 6543): the connection this API uses at runtime.
# Keep ?pgbouncer=true — the pooler does not support prepared statements.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Browser origins allowed to call this API (comma-separated).
# Local frontend is http://localhost:3000; add the deployed web origin in production,
# e.g. "https://expense-frontend.onrender.com".
CORS_ORIGINS="http://localhost:3000"

# Port this API listens on. Render overrides this at runtime.
PORT=4000
