# Supabase → Project Settings → API
SUPABASE_URL="https://<project-ref>.supabase.co"
# Service role key: server-only, bypasses RLS. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Comma-separated origins allowed to call this API (the deployed web app)
CORS_ORIGINS="http://localhost:3000"
PORT=4000
